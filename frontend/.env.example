# Frontend Environment Variables
# If deploying separately from the backend (e.g. Vercel + Render), specify the backend URLs here.
# If deploying together or behind a proxy, leave these blank and it will default to relative paths.
# tldraw hobby key is required for deployment !!
VITE_API_URL="https://api.yourdomain.com/api/v1"
VITE_SOCKET_URL="https://api.yourdomain.com"
VITE_TLDRAW_LICENSE_KEY="YOUR_HOBBY_KEY"