generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  GOOGLE
  GITHUB
}

enum BoardVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

enum InviteType {
  LINK
  SHORT_CODE
}

enum CollaboratorRole {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id         String       @id @default(uuid(7))
  isGuest    Boolean      @default(false)
  aiPromptsUsed Int       @default(0)

  email      String?      @unique
  name       String
  avatarUrl  String?
  provider   AuthProvider?
  providerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedBoards Board[] @relation("BoardOwner")

  collaborations Collaborator[]

  chatMessages ChatMessage[]

  refreshTokens RefreshToken[]

  starredBoards StarredBoard[]

  @@unique([provider, providerId])
}

model Board {
  id String @id @default(uuid(7))

  title        String
  description  String?
  thumbnailUrl String?

  visibility BoardVisibility @default(PRIVATE)
  canvasColor String?

  ownerId String
  owner   User   @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  collaborators Collaborator[]

  invites Invite[]

  snapshots Snapshot[]

  chatMessages ChatMessage[]

  starredBy StarredBoard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model Collaborator {
  id String @id @default(uuid(7))

  boardId String
  userId  String

  role CollaboratorRole

  joinedAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model Invite {
  id String @id @default(uuid(7))

  boardId String

  token String @unique

  role CollaboratorRole

  maxUses Int?

  uses Int @default(0)

  expiresAt DateTime?

  isActive Boolean @default(true)
  
  type InviteType @default(LINK)

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Snapshot {
  id String @id @default(uuid(7))

  boardId String

  version Int

  documentJson Json

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([boardId, version])
}

model ChatMessage {
  id String @id @default(uuid(7))

  boardId String

  authorId String

  content String

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model RefreshToken {
  id String @id @default(uuid(7))

  userId String

  tokenHash String @unique

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  revokedAt DateTime?
}

model StarredBoard {
  userId  String
  boardId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, boardId])
}

